            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hmm" />
        </receiver>
        <receiver
            android:name=".widget.VasilyWidget$Grumpy"
