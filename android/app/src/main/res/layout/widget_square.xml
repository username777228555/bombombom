<?xml version="1.0" encoding="utf-8"?>
<!-- Василий's widget, 2×2: the scene and a short line (ru.stolypin.app.widget.VasilyWidget). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/wg_hello_sq" />

    <LinearLayout
        android:id="@+id/streak_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="7dp"
        android:background="@drawable/widget_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_flame" />

        <TextView
            android:id="@+id/streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="#D4561C"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/say"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="7dp"
        android:background="@drawable/widget_bubble"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingMultiplier="1.05"
        android:maxLines="3"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:text="Василий"
        android:textColor="#2B1A12"
        android:textSize="12sp" />
</FrameLayout>
