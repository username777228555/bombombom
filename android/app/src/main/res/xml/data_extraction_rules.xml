<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the Google backup and a transfer to a new phone carry only the progress snapshot written by
     src/core/autobackup.ts (no AI key, books or WebView caches). Android 6–11 reads backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="autobackup/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="autobackup/" />
    </device-transfer>
</data-extraction-rules>
