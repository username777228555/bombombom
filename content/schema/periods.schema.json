{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "periods": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "short": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "integer",
            "minimum": -3000,
            "maximum": 2100
          },
          "to": {
            "type": "integer",
            "minimum": -3000,
            "maximum": 2100
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "cover": {
            "type": "string",
            "minLength": 1
          },
          "coverCredit": {
            "type": "string",
            "minLength": 1
          },
          "coverInfo": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "author": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "minLength": 1
              },
              "about": {
                "type": "string",
                "minLength": 1
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "short",
          "range",
          "from",
          "to",
          "color",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "periods"
  ],
  "additionalProperties": false
}
